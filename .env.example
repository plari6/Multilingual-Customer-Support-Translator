# ---------------- Telegram ----------------
TELEGRAM_BOT_TOKEN=            # from @BotFather
STAFF_CHAT_ID=                 # your team group: add the bot, send /whoami in the group
STAFF_TOPICS=auto              # auto | on | off  (on = one forum topic per customer; bot must be admin with "Manage topics")
# AGENT_USER_IDS=111,222       # only these Telegram users may answer customers (default: anyone in the staff group)
# PUBLIC_URL=https://support.example.com   # for webhooks (`serve` + `set-webhook`); not needed with `start`
# TELEGRAM_WEBHOOK_SECRET=long-random-string

# ---------------- DeepL ----------------
DEEPL_API_KEY=                 # https://www.deepl.com/pro-api  (free key ends with :fx, 500,000 chars/month)
# DEEPL_API_URL=               # override endpoint (auto: api-free.deepl.com for :fx keys, else api.deepl.com)
# DEEPL_ENGLISH_VARIANT=EN-US  # or EN-GB

# ---------------- Languages & behaviour ----------------
# PROFILE_FILE=examples/profile.json   # company, languages, formality, do-not-translate terms, glossary, macros
# AGENT_LANGUAGE=EN            # language your agents read and write
# SUPPORTED_LANGUAGES=EN,FR,DE # customer languages ("*" = every DeepL language)
# FALLBACK_CUSTOMER_LANGUAGE=EN
# FORMALITY=prefer_more        # prefer_more (vous/Sie) | prefer_less (tu/du) for all languages
# TRANSLATION_NOTE=true        # add "Translated automatically" under agent replies
# SHOW_ORIGINAL_TO_AGENT=true  # show the customer's original text under the translation
# FIRST_ACK=true               # "your message was passed on" auto-reply on the first message
# CONTEXT_MESSAGES=3           # previous messages sent to DeepL as context (better translations)
# DO_NOT_TRANSLATE=Acme,ProMax # extra brand terms never translated

# ---------------- HTTP / storage ----------------
PORT=3000
API_KEY=                       # protects /api/* (translate, conversations, transcripts, stats)
# DATA_FILE=data/support-translator.json
# LOG_LEVEL=info

# ---------------- AI fallback (used when DeepL is down / out of quota) ----------------
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=              # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=            # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,groq:llama-3.3-70b-versatile,...   (provider:model, comma separated)
AI_TIMEOUT_MS=10000        # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=30000   # whole answer
AI_HEDGE_MS=6000           # start the next model in parallel if the current one is silent this long (0 = off)
